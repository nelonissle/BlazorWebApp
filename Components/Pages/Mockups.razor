@page "/mockups"

<PageTitle>SaveUp | Mock-ups</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Mock-ups</p>
        <h2>Geplantes GUI-Design der SaveUp-App.</h2>
    </div>
</div>

<div class="mockup-grid">
    <section class="panel mockup-card">
        <h3>Übersicht</h3>
        <ul>
            <li>Begrüssung und kurze Anleitung</li>
            <li>KPI-Karten für Total, Anzahl und letzten Eintrag</li>
            <li>Schneller Zugriff auf die Erfassung</li>
        </ul>
    </section>

    <section class="panel mockup-card">
        <h3>Eintrag erfassen</h3>
        <ul>
            <li>Formular für Kurzbeschreibung, Preis, Datum/Uhrzeit</li>
            <li>Aktionen zum Speichern und Öffnen der Liste</li>
            <li>Validierung für eine intuitive Bedienung</li>
        </ul>
    </section>

    <section class="panel mockup-card">
        <h3>Listendarstellung</h3>
        <ul>
            <li>Tabelle mit allen Verzichtskäufen</li>
            <li>Hervorgehobene Gesamteinsparung</li>
            <li>Direkter Rücksprung zur Erfassung</li>
        </ul>
    </section>
</div>
